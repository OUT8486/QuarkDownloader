# ── Node / 前端依赖与产物 ────────────────────────────────
node_modules/
dist/
.vite/

# ── Rust / Tauri 构建产物与生成物 ────────────────────────
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk

# ── 环境变量（可能包含密钥，一律不入库） ─────────────────
.env
.env.*
!.env.example
*.local

# ── 本地保留但不需要入库的资源 ──────────────────────────
# 从 frontend/public 移出的未使用字体（体积大且不参与打包）
unused-assets/

# ── 运行期临时文件 ──────────────────────────────────────
# 多线程下载的分片临时目录（正常情况下会自动清理）
.quark_temp_*/
*.part
*.tmp
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 编辑器 / 操作系统 ───────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── 其他 ────────────────────────────────────────────────
coverage/
*.pdb
